# Параметры подключения к PostgreSQL
POSTGRES_DB=corrosion_db
POSTGRES_USER=corrosion_user
POSTGRES_PASSWORD=replace_with_secure_password
DATABASE_URL=postgresql://corrosion_user:replace_with_secure_password@db:5432/corrosion_db

# Настройки сервиса ML инференса
ML_SERVICE_URL=http://ml:8001
MODEL_PATH=/models/unet.pt

# Путь к хранилищу медиафайлов (uploads, masks, overlays)
DATA_DIR=/app/data

# Срок хранения архива инспекций в днях (автоматическая очистка старых записей и файлов)
RETENTION_DAYS=30

# Максимальный размер загружаемого изображения в мегабайтах
MAX_UPLOAD_SIZE_MB=32

# Разрешенные CORS источники для фронтенда
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Коэффициент масштаба камеры (мм на пиксель). 
# Оставьте пустым, если калибровка еще не выполнена.
MM_PER_PX=
